{
	"files": {
		"includes": ["**", "!**/bun.lock", "!**/node_modules", "!**/.direnv"]
	},
	"formatter": {
		"indentStyle": "tab"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error",
				"noUnusedFunctionParameters": "error"
			},
			"style": {
				"useConst": "error",
				"useImportType": "error",
				"useNodejsImportProtocol": "error",
				"noNonNullAssertion": "error",
				"noParameterAssign": "error"
			},
			"suspicious": {
				"noExplicitAny": "error",
				"noConsole": "off"
			},
			"complexity": {
				"noExcessiveCognitiveComplexity": {
					"level": "warn",
					"options": {
						"maxAllowedComplexity": 12
					}
				}
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.test.ts"],
			"linter": {
				"rules": {
					"complexity": {
						"noExcessiveCognitiveComplexity": "off"
					}
				}
			}
		}
	]
}
